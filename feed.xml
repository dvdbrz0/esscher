---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
  <title>Esscher</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html"/>
  <id>{{ '/feed.xml' | absolute_url }}</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <icon>{{ '/apple-touch-icon.png' | absolute_url }}</icon>
  <author><name>Esscher</name><uri>{{ '/' | absolute_url }}</uri></author>
  {% for post in site.posts limit: 20 %}{% if post.headline %}{% capture entry_title %}{{ post.title }}: {{ post.headline }}{% endcapture %}{% else %}{% assign entry_title = post.title %}{% endif %}
  <entry>
    <title type="text">{{ entry_title | strip_html | normalize_whitespace | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html"/>
    <id>{{ post.url | absolute_url }}</id>
    <published>{% if post.published %}{{ post.published | date_to_xmlschema }}{% else %}{{ post.date | date_to_xmlschema }}{% endif %}</published>
    <updated>{% if post.updated %}{{ post.updated | date_to_xmlschema }}{% elsif post.published %}{{ post.published | date_to_xmlschema }}{% else %}{{ post.date | date_to_xmlschema }}{% endif %}</updated>
    {% if post.description %}<summary type="text">{{ post.description | strip_html | normalize_whitespace | xml_escape }}</summary>{% endif %}
    <content type="html" xml:base="{{ post.url | absolute_url }}"><![CDATA[{{ post.content }}]]></content>
  </entry>
  {% endfor %}
</feed>
